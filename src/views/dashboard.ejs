<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal SST - <%= obra.nome_obra %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen">

  <header class="bg-slate-900 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex justify-between items-center">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-500">Quattro Construtora • Portal SST</span>
        <h1 class="text-2xl font-extrabold mt-1"><%= obra.nome_obra %></h1>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Navegação por Abas -->
    <div class="border-b border-slate-200 mb-8">
      <nav class="-mb-px flex space-x-8" aria-label="Tabs">
        <button 
          onclick="switchTab('obra')" 
          id="tab-btn-obra"
          class="border-b-2 border-amber-500 py-4 px-1 text-sm font-bold text-amber-600 flex items-center space-x-2 focus:outline-none transition-all"
        >
          <i class="fa-solid fa-building-shield"></i>
          <span>Documentos da Obra</span>
        </button>

        <button 
          onclick="switchTab('colaboradores')" 
          id="tab-btn-colaboradores"
          class="border-b-2 border-transparent py-4 px-1 text-sm font-medium text-slate-500 hover:text-slate-700 hover:border-slate-300 flex items-center space-x-2 focus:outline-none transition-all"
        >
          <i class="fa-solid fa-users"></i>
          <span>Gestão de Colaboradores</span>
        </button>
      </nav>
    </div>

    <!-- Aba 1: Documentos da Obra -->
    <section id="tab-content-obra" class="block">
      <div class="mb-6">
        <h2 class="text-lg font-bold text-slate-800">Documentação Técnica Institucional</h2>
        <p class="text-sm text-slate-500">Documentos regulatórios de Segurança do Trabalho vinculados ao empreendimento.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% documentosObra.forEach(item => { %>
          <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between mb-3">
                <span class="inline-block px-2.5 py-1 text-xs font-bold rounded-md bg-slate-100 text-slate-700">
                  <%= item.categoriaChave %>
                </span>
                <% if (item.documento) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border <%= item.documento.statusInfo.badgeClass %>">
                    <span class="w-1.5 h-1.5 rounded-full mr-1.5 <%= item.documento.statusInfo.status === 'valido' ? 'bg-emerald-500' : 'bg-red-500' %>"></span>
                    <%= item.documento.statusInfo.texto %>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                    Pendente
                  </span>
                <% } %>
              </div>

              <h3 class="text-base font-bold text-slate-900 mb-2"><%= item.categoriaNome %></h3>
              
              <div class="text-xs text-slate-500 space-y-1 mb-4">
                <% if (item.documento) { %>
                  <p><i class="fa-regular fa-calendar mr-1"></i> Validade: <strong><%= new Date(item.documento.data_vencimento).toLocaleDateString('pt-BR') %></strong></p>
                <% } else { %>
                  <p class="italic text-slate-400">Nenhum documento anexado.</p>
                <% } %>
              </div>
            </div>

            <div>
              <% if (item.documento && item.documento.file_url) { %>
                <a href="<%= item.documento.file_url %>" target="_blank" rel="noopener noreferrer" class="w-full inline-flex justify-center items-center px-4 py-2 text-sm font-medium text-slate-700 bg-slate-50 border border-slate-300 rounded-lg hover:bg-slate-100 transition-colors">
                  <i class="fa-regular fa-file-pdf text-red-600 mr-2"></i> Visualizar PDF
                </a>
              <% } else { %>
                <button disabled class="w-full inline-flex justify-center items-center px-4 py-2 text-sm font-medium text-slate-400 bg-slate-100 border border-slate-200 rounded-lg cursor-not-allowed">
                  Indisponível
                </button>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Aba 2: Colaboradores -->
    <section id="tab-content-colaboradores" class="hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-lg font-bold text-slate-800">Conferência de Trabalhadores</h2>
          <p class="text-sm text-slate-500">Validação individual de ASO, NR-10, NR-18, NR-35 e Ficha de EPI.</p>
        </div>

        <div class="relative w-full sm:w-80">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input 
            type="text" 
            id="searchColab" 
            onkeyup="filterColaboradores()" 
            placeholder="Buscar por Nome ou CPF..." 
            class="w-full pl-10 pr-4 py-2 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all shadow-sm"
          >
        </div>
      </div>

      <div class="space-y-4" id="colaboradoresList">
        <% if (colaboradores && colaboradores.length > 0) { %>
          <% colaboradores.forEach((colab, index) => { %>
            <div class="colab-card bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm transition-all" data-search="<%= colab.nome.toLowerCase() %> <%= colab.cpf %>">
              <button 
                type="button" 
                onclick="toggleAccordion('colab-<%= index %>')" 
                class="w-full px-6 py-4 flex items-center justify-between bg-white hover:bg-slate-50 text-left transition-colors focus:outline-none"
              >
                <div class="flex items-center space-x-4">
                  <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-800 font-bold flex items-center justify-center text-sm">
                    <%= colab.nome.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase() %>
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-900"><%= colab.nome %></h3>
                    <p class="text-xs text-slate-500"><%= colab.funcao %> • CPF: <%= colab.cpf %></p>
                  </div>
                </div>

                <div class="flex items-center space-x-3">
                  <i id="icon-colab-<%= index %>" class="fa-solid fa-chevron-down text-slate-400 transition-transform duration-200"></i>
                </div>
              </button>

              <div id="colab-<%= index %>" class="hidden px-6 py-4 border-t border-slate-100 bg-slate-50/50">
                <p class="text-xs font-bold uppercase text-slate-400 tracking-wider mb-3">Documentos e Qualificações SST:</p>
                
                <div class="flex flex-wrap gap-2">
                  <% colab.documentos.forEach(docItem => { %>
                    <% if (docItem.documento) { %>
                      <a 
                        href="<%= docItem.documento.file_url %>" 
                        target="_blank" 
                        class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all shadow-sm <%= docItem.documento.statusInfo.badgeClass %> hover:opacity-80"
                        title="Validade: <%= new Date(docItem.documento.data_vencimento).toLocaleDateString('pt-BR') %>"
                      >
                        <span class="font-bold mr-1.5"><%= docItem.categoria %>:</span> 
                        <%= docItem.documento.statusInfo.texto %> 👁️
                      </a>
                    <% } else { %>
                      <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-100 text-slate-500 border border-slate-200">
                        <span class="font-bold mr-1.5"><%= docItem.categoria %>:</span> Não Cadastrado
                      </span>
                    <% } %>
                  <% }); %>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="text-center py-12 bg-white rounded-xl border border-slate-200">
            <i class="fa-solid fa-user-slash text-4xl text-slate-300 mb-3"></i>
            <p class="text-slate-500 font-medium">Nenhum colaborador registrado nesta obra.</p>
          </div>
        <% } %>
      </div>
    </section>

  </main>

  <script>
    function switchTab(tabName) {
      const tabObra = document.getElementById('tab-content-obra');
      const tabColab = document.getElementById('tab-content-colaboradores');
      const btnObra = document.getElementById('tab-btn-obra');
      const btnColab = document.getElementById('tab-btn-colaboradores');

      if (tabName === 'obra') {
        tabObra.classList.remove('hidden');
        tabColab.classList.add('hidden');
        
        btnObra.className = 'border-b-2 border-amber-500 py-4 px-1 text-sm font-bold text-amber-600 flex items-center space-x-2 focus:outline-none transition-all';
        btnColab.className = 'border-b-2 border-transparent py-4 px-1 text-sm font-medium text-slate-500 hover:text-slate-700 hover:border-slate-300 flex items-center space-x-2 focus:outline-none transition-all';
      } else {
        tabObra.classList.add('hidden');
        tabColab.classList.remove('hidden');

        btnColab.className = 'border-b-2 border-amber-500 py-4 px-1 text-sm font-bold text-amber-600 flex items-center space-x-2 focus:outline-none transition-all';
        btnObra.className = 'border-b-2 border-transparent py-4 px-1 text-sm font-medium text-slate-500 hover:text-slate-700 hover:border-slate-300 flex items-center space-x-2 focus:outline-none transition-all';
      }
    }

    function toggleAccordion(id) {
      const content = document.getElementById(id);
      const icon = document.getElementById('icon-' + id);
      
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
      } else {
        content.classList.add('hidden');
        icon.classList.remove('rotate-180');
      }
    }

    function filterColaboradores() {
      const query = document.getElementById('searchColab').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.colab-card');

      cards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        if (searchData.includes(query)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }
  </script>
</body>
</html>